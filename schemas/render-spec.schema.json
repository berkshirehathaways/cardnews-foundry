{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stevenshin.github.io/cardnews-foundry/schemas/render-spec.schema.json",
  "title": "RenderSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "renderSpecId", "visualRecipeDigest", "target", "theme", "dimensions", "codec", "cardOrder", "environment"],
  "properties": {
    "schemaVersion": { "$ref": "#/$defs/version" },
    "renderSpecId": { "$ref": "#/$defs/id" },
    "visualRecipeDigest": { "$ref": "#/$defs/sha256" },
    "target": { "$ref": "#/$defs/versionedId" },
    "theme": { "$ref": "#/$defs/versionedId" },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "height": { "type": "integer", "minimum": 1, "maximum": 8192 }
      }
    },
    "codec": { "enum": ["png", "jpeg"] },
    "cardOrder": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "browser", "browserRevision", "locale", "timezone", "deviceScaleFactor"],
      "properties": {
        "platform": { "type": "string", "minLength": 1 },
        "browser": { "type": "string", "minLength": 1 },
        "browserRevision": { "type": "string", "minLength": 1 },
        "locale": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$" },
        "timezone": { "type": "string", "pattern": "^[A-Za-z_]+/[A-Za-z_]+$" },
        "deviceScaleFactor": { "type": "number", "exclusiveMinimum": 0, "maximum": 4 }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "versionedId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" }
      }
    }
  }
}
