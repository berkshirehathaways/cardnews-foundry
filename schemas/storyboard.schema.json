{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stevenshin.github.io/cardnews-foundry/schemas/storyboard.schema.json",
  "title": "Storyboard",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "storyboardId", "editorialBriefDigest", "cards"],
  "properties": {
    "schemaVersion": { "$ref": "#/$defs/version" },
    "storyboardId": { "$ref": "#/$defs/id" },
    "editorialBriefDigest": { "$ref": "#/$defs/sha256" },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "order", "role", "headline", "body", "claimIds", "sourceSpanIds"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "order": { "type": "integer", "minimum": 0 },
          "role": { "enum": ["hook", "context", "evidence", "insight", "closing"] },
          "headline": { "type": "string", "minLength": 1 },
          "body": { "type": "string", "minLength": 1 },
          "claimIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
          "sourceSpanIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
