{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stevenshin.github.io/cardnews-foundry/schemas/visual-verdict-record.schema.json",
  "title": "VisualVerdictRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "verdictId", "renderSetDigest", "captureSetDigest", "sourceRevision", "reviewer", "evidenceIdentity", "category", "differences", "blockers", "verdict"],
  "properties": {
    "schemaVersion": { "$ref": "#/$defs/version" },
    "verdictId": { "$ref": "#/$defs/id" },
    "renderSetDigest": { "$ref": "#/$defs/sha256" },
    "captureSetDigest": { "$ref": "#/$defs/sha256" },
    "sourceRevision": { "type": "string", "minLength": 1 },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["codex", "external-adapter", "human"] }
      }
    },
    "evidenceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths", "capturedAt"],
      "properties": {
        "paths": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/relativePath" } },
        "capturedAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "category": { "enum": ["design-system", "visual-fidelity", "cjk-precision", "combined"] },
    "differences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cardId", "kind", "severity", "description"],
        "properties": {
          "cardId": { "$ref": "#/$defs/id" },
          "kind": { "$ref": "#/$defs/id" },
          "severity": { "enum": ["info", "warning", "blocking"] },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "blockers": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "verdict": { "enum": ["PASS", "FAIL"] }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$" },
    "relativePath": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+$" }
  }
}
