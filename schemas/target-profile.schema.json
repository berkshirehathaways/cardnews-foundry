{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardnews-foundry.example/schemas/target-profile.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "targetId", "dimensions", "output", "safeArea", "cardCount"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "targetId": { "const": "portrait-social-1080x1350" },
    "dimensions": { "$ref": "#/$defs/dimensions" },
    "output": { "$ref": "#/$defs/output" },
    "safeArea": { "$ref": "#/$defs/safeArea" },
    "cardCount": { "$ref": "#/$defs/cardCount" }
  },
  "$defs": {
    "dimensions": { "type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": { "width": { "const": 1080 }, "height": { "const": 1350 } } },
    "output": {
      "type": "object", "additionalProperties": false,
      "required": ["codec", "mimeType", "colorSpace", "alpha"],
      "properties": {
        "codec": { "const": "png" },
        "mimeType": { "const": "image/png" },
        "colorSpace": { "const": "srgb" },
        "alpha": { "const": "opaque" }
      }
    },
    "safeArea": {
      "type": "object", "additionalProperties": false, "required": ["insets", "content", "documentation"],
      "properties": {
        "insets": { "type": "object", "additionalProperties": false, "required": ["top", "right", "bottom", "left"], "properties": { "top": { "type": "integer", "minimum": 96 }, "right": { "type": "integer", "minimum": 80 }, "bottom": { "type": "integer", "minimum": 96 }, "left": { "type": "integer", "minimum": 80 } } },
        "content": { "type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": { "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 } } },
        "documentation": { "type": "string", "minLength": 20, "description": "Safe inset guidance for platform controls and edge crops." }
      }
    },
    "cardCount": { "type": "object", "additionalProperties": false, "required": ["minimum", "maximum", "rationale"], "properties": { "minimum": { "type": "integer", "minimum": 1 }, "maximum": { "type": "integer", "minimum": 1 }, "rationale": { "type": "string", "minLength": 20 } } }
  }
}
