{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stevenshin.github.io/cardnews-foundry/schemas/source-envelope.schema.json",
  "title": "SourceEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceId", "title", "spans", "provenance"],
  "properties": {
    "schemaVersion": { "$ref": "#/$defs/version" },
    "sourceId": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1 },
    "spans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "order"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "text": { "type": "string", "minLength": 1 },
          "order": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["originalLocator", "finalLocator", "redirectChain", "retrievedAt", "rawSha256", "rawByteCount", "declaredMime", "detectedMime", "parser", "extractedSpanIds", "rightsStatus", "transformations"],
      "properties": {
        "originalLocator": { "type": "string", "minLength": 1 },
        "finalLocator": { "type": "string", "minLength": 1 },
        "redirectChain": { "type": "array", "items": { "type": "string", "pattern": "^https://" } },
        "retrievedAt": { "$ref": "#/$defs/timestamp" },
        "rawSha256": { "$ref": "#/$defs/sha256" },
        "rawByteCount": { "type": "integer", "minimum": 0 },
        "declaredMime": { "$ref": "#/$defs/sourceMime" },
        "detectedMime": { "$ref": "#/$defs/sourceMime" },
        "parser": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "$ref": "#/$defs/id" },
            "version": { "$ref": "#/$defs/version" }
          }
        },
        "extractedSpanIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
        "rightsStatus": { "$ref": "#/$defs/rights" },
        "transformations": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$" },
    "sourceMime": { "enum": ["text/html", "application/xhtml+xml", "text/plain", "text/markdown"] },
    "rights": { "enum": ["generated", "user-provided", "licensed", "public-domain", "unknown"] }
  }
}
