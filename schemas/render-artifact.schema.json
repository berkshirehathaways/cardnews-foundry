{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stevenshin.github.io/cardnews-foundry/schemas/render-artifact.schema.json",
  "title": "RenderArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactId", "renderSpecDigest", "cardId", "relativePath", "mediaType", "mediaSignature", "width", "height", "sha256", "dependencyDigests"],
  "properties": {
    "schemaVersion": { "$ref": "#/$defs/version" },
    "artifactId": { "$ref": "#/$defs/id" },
    "renderSpecDigest": { "$ref": "#/$defs/sha256" },
    "cardId": { "$ref": "#/$defs/id" },
    "relativePath": { "$ref": "#/$defs/relativePath" },
    "mediaType": { "enum": ["image/png", "image/jpeg"] },
    "mediaSignature": { "type": "string", "pattern": "^[a-f0-9]{6,32}$" },
    "width": { "type": "integer", "minimum": 1, "maximum": 8192 },
    "height": { "type": "integer", "minimum": 1, "maximum": 8192 },
    "sha256": { "$ref": "#/$defs/sha256" },
    "dependencyDigests": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sha256" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "relativePath": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+$" }
  }
}
